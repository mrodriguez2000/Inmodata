
# IMAGEN BASE DE PYTHON
FROM python:3.12-slim

# DEFINIR DIRECTORIO DE TRABAJO
WORKDIR /app

# EVITAR ARCHIVOS .pyc Y PERMITIR LOGS INMEDIATOS
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

# COPIAR DEPENDENCIAS
COPY requirements.txt .

# INSTALAR LIBRERIAS DE PYTHON
RUN pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir -r requirements.txt

# INSTALAR CHROMIUM Y SUS DEPENDENCIAS PARA PLAYWRIGHT
RUN python -m playwright install --with-deps chromium

# COPIAR CODIGO DEL PROYECTO
COPY . .

# EXPONER EL PUERTO UTILIZADO POR FASTAPI
EXPOSE 8000

# INICIAR LA API CON UVICORN
CMD ["uvicorn", "Scripts.Archivos.api:app", "--host", "0.0.0.0", "--port", "8000"]